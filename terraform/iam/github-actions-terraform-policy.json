{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::<TERRAFORM_STATE_BUCKET>"
    },
    {
      "Sid": "TerraformStateObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::<TERRAFORM_STATE_BUCKET>/platform-demo-app/terraform.tfstate"
    },
    {
      "Sid": "TerraformStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<TERRAFORM_STATE_BUCKET>/platform-demo-app/terraform.tfstate.tflock"
    },
    {
      "Sid": "TerraformManagedBucketsRead",
      "Effect": "Allow",
      "Action": [
        "s3:Get*",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<TERRAFORM_BUCKET>",
        "arn:aws:s3:::<MODULE_BUCKET>"
      ]
    },
    {
      "Sid": "TerraformManagedBucketObjectsRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::<TERRAFORM_BUCKET>/*",
        "arn:aws:s3:::<MODULE_BUCKET>/*"
      ]
    },
    {
      "Sid": "TerraformIdentity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
